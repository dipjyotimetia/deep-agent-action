{
  "name": "deep-agent-action",
  "version": "0.1.0",
  "description": "A GitHub Action that runs an issue/PR coding agent powered by the Deep Agents JS harness, in-process on the runner.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "DEEP_AGENT_SMOKE=1 bun run src/index.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/aws": "^1.4.2",
    "@langchain/core": "^1.2.1",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/google-vertexai": "^2.2.0",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.3",
    "@octokit/auth-app": "^8.2.0",
    "deepagents": "^1.10.5",
    "langchain": "^1.5.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "prettier": "^3.9.4",
    "typescript": "^7.0.2"
  }
}
